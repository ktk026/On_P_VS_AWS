{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllCombinedPermissions",
            "Effect": "Allow",
            "Action": [
                "ecr:*",
                "ec2:*",
                "ecs:*",
                "eks:*",
                "rds:*",
                "vpc:*",
                "cloudformation:*",
                "iam:*",
                "ssm:PutParameter",
                "ssm:DeleteParameter",
                "ssm:GetParameter",
                "ssm:GetParameters",
                "ssm:GetParametersByPath",
                "ssm:DescribeParameters",
                "ssm:AddTagsToResource",
                "elasticloadbalancing:*",
                "ec2:DescribeNetworkInterfaces",
                "ec2:DetachNetworkInterface",
                "ec2:DeleteNetworkInterface"
            ],
            "Resource": "*"
        },
        {
            "Sid": "S3AccessPermissions",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::shoply-postgresql",
                "arn:aws:s3:::shoply-postgresql/*"
            ]
        }
    ]
}
